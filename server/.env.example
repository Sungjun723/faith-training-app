NODE_ENV=production
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=faith_training

# openssl rand -base64 32 등으로 생성한 무작위 문자열 사용
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# 비밀번호 재설정 이메일 발송용 SMTP (Hostinger 이메일 호스팅 정보 또는 외부 SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="신앙훈련 노트 <no-reply@yourdomain.com>"
# 프런트엔드가 배포된 실제 도메인 (재설정 링크 생성에 사용)
APP_BASE_URL=https://yourdomain.com
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=60

# db:seed 실행 시에만 사용되는 최초 관리자 계정 정보
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
